#Область ПрограммныйИнтерфейс

// Рассчитывает сумму начисления по окладу за отработанные дни месяца.
//
// Параметры:
//  Оклад - Число - оклад сотрудника за полный месяц.
//  ОтработаноДней - Число - количество отработанных дней.
//  ВсегоРабочихДней - Число - количество рабочих дней в месяце.
//
// Возвращаемое значение:
//  Число - сумма начисления, округленная до копеек.
//
Функция РассчитатьПоОкладу(Оклад, ОтработаноДней, ВсегоРабочихДней) Экспорт

	Если ВсегоРабочихДней <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Окр(Оклад * ОтработаноДней / ВсегоРабочихДней, 2, 1);

КонецФункции

// Возвращает ставку НДФЛ из вида удержания "НДФЛ".
//
// Возвращаемое значение:
//  Число - ставка в процентах; 13, если ставка в плане видов расчета не заполнена.
//
Функция СтавкаНДФЛ() Экспорт

	ВидУдержания = ПланыВидовРасчета.Удержания.НДФЛ.Получить();
	Если ВидУдержания.Ставка > 0 Тогда
		Возврат ВидУдержания.Ставка;
	КонецЕсли;

	Возврат 13;

КонецФункции

// Рассчитывает сумму НДФЛ.
//
// Параметры:
//  Сумма - Число - сумма начисления.
//
// Возвращаемое значение:
//  Число - сумма налога, округленная до копеек.
//
Функция СуммаНДФЛ(Сумма) Экспорт

	Возврат Окр(Сумма * СтавкаНДФЛ() / 100, 2, 1);

КонецФункции

// Заполняет табличную часть "Сотрудники" документа "Начисление зарплаты"
// работающими сотрудниками организации с расчетом начислений и удержаний.
//
// Параметры:
//  Документ - ДокументОбъект.НачислениеЗарплаты - заполняемый документ.
//
Процедура ЗаполнитьТаблицуНачисления(Документ) Экспорт

	Документ.Сотрудники.Очистить();

	ДатаНачисления = ОбщегоНазначенияКлиентСервер.НачалоМесяцаНачисления(Документ.МесяцНачисления);
	РабочихДней = ОбщегоНазначения.РабочихДнейВМесяце(ДатаНачисления);
	СотрудникиОрганизации = КадровыйУчет.СотрудникиОрганизации(Документ.Организация, ДатаНачисления);

	Для Каждого ДанныеСотрудника Из СотрудникиОрганизации Цикл
		НоваяСтрока = Документ.Сотрудники.Добавить();
		НоваяСтрока.Сотрудник = ДанныеСотрудника.Сотрудник;
		НоваяСтрока.ОтработаноДней = РабочихДней;
		НоваяСтрока.ОтработаноЧасов = РабочихДней * 8;
		НоваяСтрока.Начислено = РассчитатьПоОкладу(ДанныеСотрудника.Оклад, НоваяСтрока.ОтработаноДней, РабочихДней);
		НоваяСтрока.Удержано = СуммаНДФЛ(НоваяСтрока.Начислено);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
