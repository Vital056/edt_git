#Область ПрограммныйИнтерфейс

// тест для пуш


// Возвращает кадровые данные сотрудника на указанную дату.
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники - сотрудник, по которому нужны данные.
//  Дата - Дата - дата, на которую нужны кадровые данные.
//
// Возвращаемое значение:
//  Структура - кадровые данные сотрудника:
//   * Организация - СправочникСсылка.Организации, Неопределено - организация;
//   * Подразделение - СправочникСсылка.Подразделения, Неопределено - подразделение;
//   * Должность - СправочникСсылка.Должности, Неопределено - должность;
//   * Оклад - Число - оклад;
//   * ВидСобытия - ПеречислениеСсылка.ВидыКадровыхСобытий, Неопределено - вид кадрового события;
//   * ДатаСобытия - Дата - дата кадрового события.
//  Если кадровых данных нет, все свойства структуры пустые.
//
Функция КадровыеДанныеСотрудника(Сотрудник, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КадроваяИсторияСрезПоследних.Организация КАК Организация,
		|	КадроваяИсторияСрезПоследних.Подразделение КАК Подразделение,
		|	КадроваяИсторияСрезПоследних.Должность КАК Должность,
		|	КадроваяИсторияСрезПоследних.Оклад КАК Оклад,
		|	КадроваяИсторияСрезПоследних.ВидСобытия КАК ВидСобытия,
		|	КадроваяИсторияСрезПоследних.ДатаСобытия КАК ДатаСобытия
		|ИЗ
		|	РегистрСведений.КадроваяИстория.СрезПоследних(
		|		&Дата,
		|		Сотрудник = &Сотрудник) КАК КадроваяИсторияСрезПоследних";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);

	Выборка = Запрос.Выполнить().Выбрать();

	Данные = Новый Структура;
	Если Выборка.Следующий() Тогда
		Данные.Вставить("Организация", Выборка.Организация);
		Данные.Вставить("Подразделение", Выборка.Подразделение);
		Данные.Вставить("Должность", Выборка.Должность);
		Данные.Вставить("Оклад", Выборка.Оклад);
		Данные.Вставить("ВидСобытия", Выборка.ВидСобытия);
		Данные.Вставить("ДатаСобытия", Выборка.ДатаСобытия);
	Иначе
		Данные.Вставить("Организация", Неопределено);
		Данные.Вставить("Подразделение", Неопределено);
		Данные.Вставить("Должность", Неопределено);
		Данные.Вставить("Оклад", 0);
		Данные.Вставить("ВидСобытия", Неопределено);
		Данные.Вставить("ДатаСобытия", Дата(1, 1, 1));
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Возвращает таблицу работающих сотрудников организации с кадровыми данными на указанную дату.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, по которой отбираются сотрудники.
//  Дата - Дата - дата, на которую нужны кадровые данные.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Сотрудник, Подразделение, Должность, Оклад.
//  Уволенные сотрудники в таблицу не попадают.
//
Функция СотрудникиОрганизации(Организация, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КадроваяИсторияСрезПоследних.Сотрудник КАК Сотрудник,
		|	КадроваяИсторияСрезПоследних.Подразделение КАК Подразделение,
		|	КадроваяИсторияСрезПоследних.Должность КАК Должность,
		|	КадроваяИсторияСрезПоследних.Оклад КАК Оклад
		|ИЗ
		|	РегистрСведений.КадроваяИстория.СрезПоследних(
		|		&Дата,
		|		Организация = &Организация
		|			И ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)) КАК КадроваяИсторияСрезПоследних
		|ГДЕ
		|	КадроваяИсторияСрезПоследних.Сотрудник.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Записывает кадровое событие сотрудника в регистр сведений "Кадровая история".
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники - сотрудник, по которому записывается событие.
//  ДатаСобытия - Дата - дата кадрового события (приема, перевода, увольнения).
//  Организация - СправочникСсылка.Организации - организация сотрудника.
//  Подразделение - СправочникСсылка.Подразделения - подразделение сотрудника.
//  Должность - СправочникСсылка.Должности - должность сотрудника.
//  Оклад - Число - оклад сотрудника.
//  ВидСобытия - ПеречислениеСсылка.ВидыКадровыхСобытий - вид кадрового события.
//
Процедура ЗаписатьКадровоеСобытие(Сотрудник, ДатаСобытия, Организация, Подразделение, Должность,
	Оклад, ВидСобытия) Экспорт

	МенеджерЗаписи = РегистрыСведений.КадроваяИстория.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата(Год(ДатаСобытия), Месяц(ДатаСобытия), День(ДатаСобытия));
	МенеджерЗаписи.Сотрудник = Сотрудник;
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Подразделение = Подразделение;
	МенеджерЗаписи.Должность = Должность;
	МенеджерЗаписи.Оклад = Оклад;
	МенеджерЗаписи.ВидСобытия = ВидСобытия;
	МенеджерЗаписи.ДатаСобытия = ДатаСобытия;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Удаляет кадровое событие сотрудника из регистра сведений "Кадровая история".
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники - сотрудник, по которому удаляется событие.
//  ДатаСобытия - Дата - дата кадрового события.
//
Процедура УдалитьКадровоеСобытие(Сотрудник, ДатаСобытия) Экспорт

	МенеджерЗаписи = РегистрыСведений.КадроваяИстория.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата(Год(ДатаСобытия), Месяц(ДатаСобытия), День(ДатаСобытия));
	МенеджерЗаписи.Сотрудник = Сотрудник;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
