#Область ПрограммныйИнтерфейс

// Выводит пользователю предупреждение.
//
// Параметры:
//  Текст - Строка - текст предупреждения.
//  Заголовок - Строка - заголовок предупреждения.
//
Процедура ВывестиПредупреждение(Текст, Заголовок = "Зарплата и управление персоналом") Экспорт

	ВывестиСообщение(Заголовок + ": " + Текст);

КонецПроцедуры

// Выводит пользователю сообщение об успешном выполнении операции.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//
Процедура ВывестиСообщение(Текст) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
