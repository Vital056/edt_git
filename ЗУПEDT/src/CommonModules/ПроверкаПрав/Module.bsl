#Область ПрограммныйИнтерфейс

// Определяет, доступна ли текущему пользователю роль "Полные права".
//
// Возвращаемое значение:
//  Булево - Истина, если роль доступна.
//
Функция ЭтоПолноправныйПользователь() Экспорт

	Возврат РольДоступна("ПолныеПрава");

КонецФункции

// Прерывает выполнение операции, если у пользователя нет роли "Полные права".
//
// Вызывает исключение:
//  Недостаточно прав для выполнения операции - если роль недоступна.
//
Процедура ТребоватьПолныеПрава() Экспорт

	Если Не ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение "Недостаточно прав для выполнения операции.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
