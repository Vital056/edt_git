#Область ПрограммныйИнтерфейс

// Возвращает организацию, заданную в константе "Основная организация".
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - организация по умолчанию; пустая ссылка, если константа не заполнена.
//
Функция ОрганизацияПоУмолчанию() Экспорт

	Возврат Константы.ОсновнаяОрганизация.Получить();

КонецФункции

// Возвращает последний день месяца, в котором находится указанная дата.
//
// Параметры:
//  Дата - Дата - произвольная дата.
//
// Возвращаемое значение:
//  Дата - последний день месяца указанной даты.
//
Функция КонецМесяцаНачисления(Дата) Экспорт

	Возврат ДобавитьМесяц(Дата(Год(Дата), Месяц(Дата), 1), 1) - 1;

КонецФункции

// Считает количество рабочих дней (понедельник - пятница) в месяце.
//
// Параметры:
//  Месяц - Дата - любая дата месяца, за который считается количество рабочих дней.
//
// Возвращаемое значение:
//  Число - количество рабочих дней в месяце.
//
Функция РабочихДнейВМесяце(Месяц) Экспорт

	ПоследнийДень = КонецМесяцаНачисления(Месяц);
	КоличествоРабочихДней = 0;

	Для НомерДня = 1 По День(ПоследнийДень) Цикл
		ТекущаяДата = Дата(Год(Месяц), Месяц(Месяц), НомерДня);
		Если ДеньНедели(ТекущаяДата) < 6 Тогда
			КоличествоРабочихДней = КоличествоРабочихДней + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоРабочихДней;

КонецФункции

#КонецОбласти
