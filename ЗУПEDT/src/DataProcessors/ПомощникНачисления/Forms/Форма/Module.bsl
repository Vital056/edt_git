#Область ОбработчикиКомандФормы

&НаКлиенте
// Обработчик команды "Сформировать начисление".
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
Процедура СформироватьНачисление(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.ВывестиПредупреждение("Не заполнена организация.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Месяц) Тогда
		ОбщегоНазначенияКлиент.ВывестиПредупреждение("Не заполнен месяц начисления.");
		Возврат;
	КонецЕсли;

	ТекстРезультата = СформироватьНачислениеНаСервере();
	ОбщегоНазначенияКлиент.ВывестиСообщение(ТекстРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
// Создает и проводит документ "Начисление зарплаты" по работающим сотрудникам организации.
//
// Возвращаемое значение:
//  Строка - текст сообщения о результате.
//
Функция СформироватьНачислениеНаСервере()

	Документ = Документы.НачислениеЗарплаты.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Организация = Организация;
	Документ.МесяцНачисления = ОбщегоНазначенияКлиентСервер.НачалоМесяцаНачисления(Месяц);

	РасчетЗарплаты.ЗаполнитьТаблицуНачисления(Документ);

	Если Документ.Сотрудники.Количество() = 0 Тогда
		Возврат "В организации нет работающих сотрудников на " + Формат(Месяц, "ДЛФ=D") + ".";
	КонецЕсли;

	Документ.Записать(РежимЗаписиДокумента.Проведение);

	Возврат "Создано начисление " + Документ.Номер + " от " + Формат(Документ.Дата, "ДЛФ=D")
		+ ". Сотрудников: " + Документ.Сотрудники.Количество() + ".";

КонецФункции

#КонецОбласти
