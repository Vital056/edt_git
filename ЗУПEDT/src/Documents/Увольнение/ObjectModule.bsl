#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Записывает кадровое событие "Увольнение" при проведении документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудника(Сотрудник, ДатаУвольнения);

	КадровыйУчет.ЗаписатьКадровоеСобытие(
		Сотрудник,
		ДатаУвольнения,
		Организация,
		КадровыеДанные.Подразделение,
		КадровыеДанные.Должность,
		0,
		Перечисления.ВидыКадровыхСобытий.Увольнение);

КонецПроцедуры

// Удаляет кадровое событие при отмене проведения документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)

	КадровыйУчет.УдалитьКадровоеСобытие(Сотрудник, ДатаУвольнения);

КонецПроцедуры

// Проверяет заполнение обязательных реквизитов и корректность даты увольнения.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи документа.
//  ПроверяемыеРеквизиты - Массив из Строка - реквизиты, которые проверяет платформа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		СообщитьОбОшибке("Не заполнен сотрудник.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаУвольнения) Тогда
		СообщитьОбОшибке("Не заполнена дата увольнения.", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение об ошибке заполнения и устанавливает признак отказа.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Отказ - Булево - признак отказа от записи документа.
//
Процедура СообщитьОбОшибке(Текст, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе

ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");

#КонецЕсли
