#Область ОбработчикиКомандФормы

&НаКлиенте
// Обработчик команды "Заполнить": заполняет табличную часть сотрудниками организации.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
Процедура ЗаполнитьСотрудников(Команда)

	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.ВывестиПредупреждение("Не заполнена организация.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.МесяцНачисления) Тогда
		ОбщегоНазначенияКлиент.ВывестиПредупреждение("Не заполнен месяц начисления.");
		Возврат;
	КонецЕсли;

	ЗаполнитьСотрудниковНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
// Заполняет табличную часть "Сотрудники" документа на сервере.
//
Процедура ЗаполнитьСотрудниковНаСервере()

	РасчетЗарплаты.ЗаполнитьТаблицуНачисления(Объект);

	Если Объект.Сотрудники.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В организации нет работающих сотрудников.";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
