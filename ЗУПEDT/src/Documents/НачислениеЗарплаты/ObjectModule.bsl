#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Формирует движения документа по регистрам расчета и регистру накопления.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.Начисления.Записывать = Истина;
	Движения.Удержания.Записывать = Истина;
	Движения.Взаиморасчеты.Записывать = Истина;

	ПериодРегистрации = ОбщегоНазначенияКлиентСервер.НачалоМесяцаНачисления(МесяцНачисления);
	ВидНачисления = ПланыВидовРасчета.Начисления.Оклад;
	ВидУдержания = ПланыВидовРасчета.Удержания.НДФЛ;

	Для Каждого СтрокаСотрудника Из Сотрудники Цикл

		КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудника(СтрокаСотрудника.Сотрудник, ПериодРегистрации);

		ЗаписьНачисления = Движения.Начисления.Добавить();
		ЗаписьНачисления.ПериодРегистрации = ПериодРегистрации;
		ЗаписьНачисления.Сотрудник = СтрокаСотрудника.Сотрудник;
		ЗаписьНачисления.Организация = Организация;
		ЗаписьНачисления.ВидРасчета = ВидНачисления;
		ЗаписьНачисления.Должность = КадровыеДанные.Должность;
		ЗаписьНачисления.Подразделение = КадровыеДанные.Подразделение;
		ЗаписьНачисления.ОтработаноДней = СтрокаСотрудника.ОтработаноДней;
		ЗаписьНачисления.ОтработаноЧасов = СтрокаСотрудника.ОтработаноЧасов;
		ЗаписьНачисления.Результат = СтрокаСотрудника.Начислено;

		Если СтрокаСотрудника.Удержано <> 0 Тогда
			ЗаписьУдержания = Движения.Удержания.Добавить();
			ЗаписьУдержания.ПериодРегистрации = ПериодРегистрации;
			ЗаписьУдержания.Сотрудник = СтрокаСотрудника.Сотрудник;
			ЗаписьУдержания.Организация = Организация;
			ЗаписьУдержания.ВидРасчета = ВидУдержания;
			ЗаписьУдержания.Результат = СтрокаСотрудника.Удержано;
		КонецЕсли;

		ЗаписьВзаиморасчетов = Движения.Взаиморасчеты.Добавить();
		ЗаписьВзаиморасчетов.ВидДвижения = ВидДвиженияНакопления.Приход;
		ЗаписьВзаиморасчетов.Период = ПериодРегистрации;
		ЗаписьВзаиморасчетов.Сотрудник = СтрокаСотрудника.Сотрудник;
		ЗаписьВзаиморасчетов.Организация = Организация;
		ЗаписьВзаиморасчетов.Сумма = СтрокаСотрудника.Начислено - СтрокаСотрудника.Удержано;

	КонецЦикла;

КонецПроцедуры

// Проверяет заполнение обязательных реквизитов документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи документа.
//  ПроверяемыеРеквизиты - Массив из Строка - реквизиты, которые проверяет платформа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		СообщитьОбОшибке("Не заполнена организация.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(МесяцНачисления) Тогда
		СообщитьОбОшибке("Не заполнен месяц начисления.", Отказ);
	КонецЕсли;

	Если Сотрудники.Количество() = 0 Тогда
		СообщитьОбОшибке("Табличная часть ""Сотрудники"" не заполнена.", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение об ошибке заполнения и устанавливает признак отказа.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Отказ - Булево - признак отказа от записи документа.
//
Процедура СообщитьОбОшибке(Текст, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе

ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");

#КонецЕсли
