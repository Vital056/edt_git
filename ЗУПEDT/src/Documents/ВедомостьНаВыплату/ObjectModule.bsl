#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Формирует расход по регистру накопления "Взаиморасчеты" при проведении документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.Взаиморасчеты.Записывать = Истина;

	ПериодРегистрации = ОбщегоНазначенияКлиентСервер.НачалоМесяцаНачисления(МесяцНачисления);

	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		ЗаписьВзаиморасчетов = Движения.Взаиморасчеты.Добавить();
		ЗаписьВзаиморасчетов.ВидДвижения = ВидДвиженияНакопления.Расход;
		ЗаписьВзаиморасчетов.Период = ПериодРегистрации;
		ЗаписьВзаиморасчетов.Сотрудник = СтрокаСотрудника.Сотрудник;
		ЗаписьВзаиморасчетов.Организация = Организация;
		ЗаписьВзаиморасчетов.Сумма = СтрокаСотрудника.Сумма;
	КонецЦикла;

КонецПроцедуры

// Проверяет заполнение обязательных реквизитов документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи документа.
//  ПроверяемыеРеквизиты - Массив из Строка - реквизиты, которые проверяет платформа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		СообщитьОбОшибке("Не заполнена организация.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(МесяцНачисления) Тогда
		СообщитьОбОшибке("Не заполнен месяц начисления.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидВыплаты) Тогда
		СообщитьОбОшибке("Не заполнен вид выплаты.", Отказ);
	КонецЕсли;

	Если Сотрудники.Количество() = 0 Тогда
		СообщитьОбОшибке("Табличная часть ""Сотрудники"" не заполнена.", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение об ошибке заполнения и устанавливает признак отказа.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Отказ - Булево - признак отказа от записи документа.
//
Процедура СообщитьОбОшибке(Текст, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе

ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");

#КонецЕсли
