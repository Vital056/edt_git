#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Записывает кадровое событие "Прием" при проведении документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	КадровыйУчет.ЗаписатьКадровоеСобытие(
		Сотрудник,
		ДатаПриема,
		Организация,
		Подразделение,
		Должность,
		Оклад,
		Перечисления.ВидыКадровыхСобытий.Прием);

КонецПроцедуры

// Удаляет кадровое событие при отмене проведения документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от отмены проведения.
//
Процедура ОбработкаУдаленияПроведения(Отказ)

	КадровыйУчет.УдалитьКадровоеСобытие(Сотрудник, ДатаПриема);

КонецПроцедуры

// Проверяет заполнение обязательных реквизитов документа.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи документа.
//  ПроверяемыеРеквизиты - Массив из Строка - реквизиты, которые проверяет платформа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		СообщитьОбОшибке("Не заполнена организация.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		СообщитьОбОшибке("Не заполнен сотрудник.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Должность) Тогда
		СообщитьОбОшибке("Не заполнена должность.", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаПриема) Тогда
		СообщитьОбОшибке("Не заполнена дата приема.", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение об ошибке заполнения и устанавливает признак отказа.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Отказ - Булево - признак отказа от записи документа.
//
Процедура СообщитьОбОшибке(Текст, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе

ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");

#КонецЕсли
